<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/primary_text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intro"
            android:textSize="16sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/secondary_text" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/duration_card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/seconds"
                android:gravity="center"
                android:text="@string/rewind_seconds"
                android:textSize="14sp"
                android:textColor="@color/secondary_text" />
            <EditText
                android:id="@+id/seconds"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLength="3"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:gravity="center"
                android:textSize="52sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/primary_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/seconds_unit"
                android:textSize="16sp"
                android:textColor="@color/secondary_text" />
            <Button
                android:id="@+id/save"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/save" />
        </LinearLayout>
        <TextView
            android:id="@+id/access_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/permission_disclosure"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/secondary_text" />
        <Button
            android:id="@+id/notification_settings"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/long_press_explanation"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/secondary_text" />
        <TextView
            android:id="@+id/last_result"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp"
            android:textColor="@color/secondary_text"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
